# Copy to .env.local (Next.js) and fill in. Values marked optional can be left blank.

# --- Next.js / Convex client ---
# Convex deployment URL the frontend connects to (written by `npx convex dev`).
NEXT_PUBLIC_CONVEX_URL=
# Convex deployment identifier (written by `npx convex dev`).
CONVEX_DEPLOYMENT=
# Self-hosted Convex backend URL, e.g. http://127.0.0.1:3210 (only for self-hosting).
CONVEX_SELF_HOSTED_URL=
# Admin key for the self-hosted backend, from `docker compose exec convex-backend ./generate_admin_key.sh`.
CONVEX_SELF_HOSTED_ADMIN_KEY=

# --- Convex deployment env ---
# These are NOT read from this file by Convex. Set them with:
#   pnpm exec convex env set NAME value
# Speaches (OpenAI-compatible ASR) base URL, reachable from the Convex deployment.
ASR_BASE_URL=http://localhost:8000/v1
# Default Whisper model id served by Speaches.
ASR_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
# Optional: CTranslate2 conversion of Axiveri/NaijaVox-2.0 for Pidgin, Yoruba, Hausa, Igbo (see scripts/convert-naijavox.sh).
ASR_MODEL_NAIJA=
# Optional: API key if the ASR server requires one.
ASR_API_KEY=
# OpenAI-compatible LLM base URL (Ollama), reachable from the Convex deployment.
LLM_BASE_URL=http://localhost:11434/v1
# Ollama model tag used for generation.
LLM_MODEL=gemma4:e4b
# Optional: API key if the LLM server requires one.
LLM_API_KEY=
# Public URL of the Next.js app, used for links and callbacks.
SITE_URL=http://localhost:3000

# --- Eval only (scripts that compare models; not used by the app) ---
# Comma-separated Ollama LLM tags to evaluate.
EVAL_LLM_MODELS=gemma4:e4b
# Comma-separated ASR model ids to evaluate.
EVAL_ASR_MODELS=deepdml/faster-whisper-large-v3-turbo-ct2,Systran/faster-distil-whisper-large-v3
# Optional experimental challenger: OpenAI-compatible server that accepts input_audio chat parts.
GEMMA_AUDIO_BASE_URL=
# Model name to request from the GEMMA_AUDIO_BASE_URL server.
GEMMA_AUDIO_MODEL=

# Public GitHub URL, used by the How it works page to link eval results.
NEXT_PUBLIC_REPO_URL=https://github.com/<you>/sabibook
